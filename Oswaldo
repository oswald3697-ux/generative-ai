# --- 1. LLAVE MAESTRA TÁCTICA ---
FRASE_MAESTRA = "todo los puedo en cristo que me fortalece"
# Convierte tu frase en una llave exacta de 32 bytes para AES-256
LLAVE_MAESTRA = hashlib.sha256(FRASE_MAESTRA.encode('utf-8')).digest()

# --- 2. MOTOR DE CIFRADO ---
def encriptar(mensaje, llave):
    cipher = AES.new(llave, AES.MODE_CBC)
    ct_bytes = cipher.encrypt(pad(mensaje.encode('utf-8'), AES.block_size))
    iv = base64.b64encode(cipher.iv).decode('utf-8')
    ct = base64.b64encode(ct_bytes).decode('utf-8')
    return iv, ct

def desencriptar(iv_texto, texto_cifrado, llave):
    iv = base64.b64decode(iv_texto)
    ct = base64.b64decode(texto_cifrado)
    cipher = AES.new(llave, AES.MODE_CBC, iv)
    pt = unpad(cipher.decrypt(ct), AES.block_size)
    return pt.decode('utf-8')

# --- 3. ALMACENAMIENTO LOCAL (BÓVEDA MÓVIL) ---
def guardar_local(texto_cifrado, iv):
    with open("boveda_tactica.txt", "a") as archivo:
        archivo.write(f"{iv}|{texto_cifrado}\n")
    print("\n[+] Reporte cifrado y asegurado en el dispositivo.")

def leer_local():
    print("\n--- DESCIFRANDO BÓVEDA LOCAL ---")
    if not os.path.exists("boveda_tactica.txt"):
        print("[-] Bóveda vacía.")
        return
    
    with open("boveda_tactica.txt", "r") as archivo:
        for i, linea in enumerate(archivo.readlines()):
            try:
                iv, texto_cifrado = linea.strip().split('|')
                descifrado = desencriptar(iv, texto_cifrado, LLAVE_MAESTRA)
                print(f"[{i+1}] {descifrado}")
            except Exception:
                print(f"[!] Error de integridad en reporte {i+1}")
    print("--------------------------------")


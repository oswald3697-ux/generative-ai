def sincronizar_nube(iv, texto_cifrado):
    if not NUBE_DISPONIBLE:
        print("[-] Módulo de nube (psycopg2) no instalado. Guardado solo local.")
        return
    try:
        conn = psycopg2.connect(**DB_CONFIG)
        cursor = conn.cursor()
        # Asume que crearás una tabla llamada 'inteligencia'
        cursor.execute("INSERT INTO inteligencia (iv, reporte_cifrado) VALUES (%s, %s)", (iv, texto_cifrado))
        conn.commit()
        cursor.close()
        conn.close()
        print("[+] Sincronización con la Bóveda Central (Nube) exitosa.")
    except Exception as e:
        print("[-] Sin conexión a la base de datos PostgreSQL. Verifica credenciales.")

